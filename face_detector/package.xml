<?xml version="1.0"?>
<package format="3">
  <name>face_detector</name>
  <version>0.0.1</version>
  <description>Simple face detection node using OpenCV and cv_bridge</description>

  <maintainer email="sgblu@liverpool.ac.uk">Baohong Lu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
